<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <!-- Remove link de compare do cabeçalho -->
        <referenceBlock name="catalog.compare.link" remove="true"/>


        <!-- Remove sidebar de compare -->
        <referenceBlock name="catalog.compare.sidebar" remove="true"/>


        <!-- *** ESTE é o da shelf (card de produto) em categoria *** -->
        <referenceBlock name="category.product.addto.compare" remove="true"/>


        <!-- Compare em resultados de busca -->
        <referenceBlock name="catalogsearch.product.addto.compare" remove="true"/>


        <!-- Compare em relacionados / upsell / crosssell / página de produto -->
        <referenceBlock name="crosssell.product.addto.compare" remove="true"/>
        <referenceBlock name="related.product.addto.compare" remove="true"/>
        <referenceBlock name="upsell.product.addto.compare" remove="true"/>
        <referenceBlock name="view.addto.compare" remove="true"/>


        <!-- Move o formulário de inscrição da newsletter para dentro do container footer.newsletter -->
        <move element="form.subscribe" destination="footer.newsletter" before="-"/>

    </body>
</page>
